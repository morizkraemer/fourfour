{
  "productName": "fourfour",
  "identifier": "app.ffdj.library",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5200",
    "beforeDevCommand": {
      "script": "sh -c 'pkill -f \"fourfour/app/node_modules/vite\" 2>/dev/null; sleep 0.3; exec npm run dev'",
      "cwd": "../app"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../app"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1400,
        "height": 700,
        "decorations": true,
        "backgroundColor": "#0a0a0a",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 20 },
        "visible": true,
        "focus": true,
        "center": true
      }
    ]
  },
  "plugins": {},
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.4"
    },
    "linux": {
      "deb": {
        "depends": ["libasound2t64 | libasound2", "libssl3t64 | libssl3"]
      }
    }
  }
}
