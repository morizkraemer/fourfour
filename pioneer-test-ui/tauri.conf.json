{
  "productName": "Pioneer Test UI",
  "version": "0.1.0",
  "identifier": "com.pioneer.test-ui",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5200",
    "beforeDevCommand": {
      "script": "sh -c 'pkill -f \"fourfour/app/node_modules/vite\" 2>/dev/null; sleep 0.3; exec npm run dev'",
      "cwd": "../app"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../app"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1400,
        "height": 700,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 20 },
        "visible": true,
        "focus": true,
        "center": true
      }
    ]
  },
  "plugins": {}
}
