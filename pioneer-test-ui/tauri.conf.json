{
  "productName": "Pioneer Test UI",
  "version": "0.1.0",
  "identifier": "com.pioneer.test-ui",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5200",
    "beforeDevCommand": "npm run --prefix ../app dev"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Pioneer USB Writer - Test",
        "width": 1400,
        "height": 700,
        "visible": true,
        "focus": true,
        "maximized": true
      }
    ]
  },
  "plugins": {}
}
