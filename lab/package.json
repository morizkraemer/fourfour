{
  "name": "fourfour-review-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4220 --strictPort",
    "review": "vite build && vite preview --host 127.0.0.1 --port 4220 --strictPort",
    "test": "vitest run",
    "hub:card": "vite-node scripts/hub-card.ts --",
    "hub:notes": "vite-node scripts/hub-notes.ts --",
    "hub:shot": "node scripts/review-shot.ts",
    "hub:lock": "vite-node scripts/hub-lock.ts --"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vite-node": "^3.0.0",
    "vitest": "^3.0.0"
  }
}
